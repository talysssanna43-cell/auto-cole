# Variables d'environnement pour Netlify Dev (local)
# Copie ce fichier en .env et remplis les valeurs

STRIPE_SECRET_KEY=sk_live_votre_cle_stripe
STRIPE_PUBLISHABLE_KEY=pk_live_votre_cle_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_supabase
# The legacy JWT secret from Supabase Settings > API, not a newly invented value.
# It must match the secret used by the project so secure student/admin tokens work with RLS.
SUPABASE_JWT_SECRET=le_jwt_secret_legacy_de_votre_projet_supabase
RESEND_API_KEY=re_votre_cle_resend
RESEND_FROM_EMAIL=Auto-Ecole Breteuil <paiement@votre-domaine.fr>
# Resend doit avoir un domaine verifie pour envoyer vers breteuilautoecole@gmail.com.
# En mode test Resend, l'envoi est limite a l'adresse proprietaire du compte.
URL=https://autoecolebreteuil.com

# Optional when the administrator already has is_admin=true in the users table.
ADMIN_EMAIL=breteuilautoecole@gmail.com
# ADMIN_PASSWORD_HASH=scrypt$... (only needed for the emergency admin fallback)

# Vapi telephone assistant
# Keep private Vapi keys on the server only. Never expose them in frontend files.
VAPI_PRIVATE_KEY=votre_cle_privee_vapi
VAPI_WEBHOOK_SECRET=secret_partage_vapi
VAPI_WEBHOOK_URL=https://auto-ecole-breteuil.fr/.netlify/functions/vapi-webhook
# Human transfer number must use E.164 format, for example +33491533698.
VAPI_TRANSFER_PHONE_E164=+33491533698
# Fill this after the first creation if you want npm run vapi:setup to update the same assistant.
# VAPI_ASSISTANT_ID=
# Use https://api.eu.vapi.ai if your Vapi organization is in the EU region.
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_MODEL=gpt-4o-mini

# PayPal Configuration
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_secret_paypal
PAYPAL_MODE=sandbox

# Formulaire conseiller
# Les demandes sont envoyees par email a ADMIN_EMAIL avec RESEND_FROM_EMAIL.
