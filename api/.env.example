PORT=3000

# Google OAuth client, cree dans Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# Genere automatiquement apres connexion via /api/google/oauth/start.
GOOGLE_REFRESH_TOKEN=

# A recuperer via /api/google/business/locations apres connexion.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_PLACE_ID=
